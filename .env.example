# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Secret salt for anonymizing IDs in the database
SECRET_SALT=YOUR_SECRET_SALT_KEY_HERE

# Your personal Telegram ID (get it from @userinfobot)
ADMIN_ID=123456789

# Payment link for the digital product / subscription in @tribute
TRIBUTE_LINK=https://t.me/tribute/app?startapp=YOUR_PRODUCT_ID

# Tribute API key (optional, from your @tribute dashboard)
TRIBUTE_API_KEY=YOUR_TRIBUTE_API_KEY

# Debug mode (True / False)
DEBUG=False
