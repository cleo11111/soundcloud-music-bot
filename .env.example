# Токен Telegram Бота от @BotFather
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Секретная соль для анонимизации идентификаторов в БД
SECRET_SALT=YOUR_SECRET_SALT_KEY_HERE

# Ваш личный Telegram ID (узнать можно у бота @userinfobot)
ADMIN_ID=123456789

# Ссылка на оплату цифрового продукта / подписки в @tribute
TRIBUTE_LINK=https://t.me/tribute/app?startapp=YOUR_PRODUCT_ID

# API Ключ Tribute (опционально, из личного кабинета @tribute)
TRIBUTE_API_KEY=YOUR_TRIBUTE_API_KEY

# Режим отладки (True / False)
DEBUG=False
